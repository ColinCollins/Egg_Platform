    - Term: S_congraktTips_Des_level_149
      TermType: 0
      Description: 
      Languages:
      - "\u563F\uFF01\u8BA9\u6211\u6765\u5E2E\u4F60\uFF01"
      - Hey! Let me help you!
      - Ei! Deixa eu ajudar!
      - Hei! Biar kubantu!
      - Hoy! Tutulungan kita!
      - "\u306D\u3048\uFF01\u624B\u4F1D\u308F\u305B\u3066\uFF01"
      - "\u563F\uFF01\u8B93\u6211\u4F86\u5E6B\u4F60\uFF01"
      - "\uC774\uBD10! \uB0B4\uAC00 \uB3C4\uC640\uC904\uAC8C!"
      - "\u042D\u0439! \u0414\u0430\u0432\u0430\u0439 \u043F\u043E\u043C\u043E\u0433\u0443!"
      - "\xA1Eh! \xA1Deja que te ayude!"
      - "\xA1Oye! \xA1D\xE9jame ayudarte!"
      - "Hey! Sana yard\u0131m edeyim!"
