      - "\u3053\u308C\u3067\u72EC\u308A\u5360\u3081\u3060\uFF01"
      - "\u73FE\u5728\u662F\u6211\u7684\u7368\u4EAB\u6642\u523B\uFF01"
      - "\uC774\uC81C \uB098 \uD63C\uC790 \uB3C5\uCC28\uC9C0\uD560 \uC218 \uC788\uC5B4!"
      - "\u0422\u0435\u043F\u0435\u0440\u044C \u0432\u0441\u0451 \u0442\u043E\u043B\u044C\u043A\u043E
