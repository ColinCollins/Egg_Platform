    - Term: S_congraktTips_Des_level_05
      TermType: 0
      Description: 
      Languages:
      - "\u8FD9\u8BA9\u6211\u60F3\u8D77\u4E86\u6211\u73A9\u8FC7\u7684\u4E00\u6B3E\u6E38\u620F\u2026\u2026"
