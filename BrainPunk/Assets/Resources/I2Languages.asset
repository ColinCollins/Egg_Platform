    - Term: S_congraktTips_Des_level_21
      TermType: 0
      Description: 
      Languages:
      - "\u591C\u6DF1\u4E86\uFF0C\u522B\u6270\u6C11\u54DF~"
      - "It's late at night ! \nKeep your \nvoice down !"
      - "J\xE1 \xE9 noite! Sil\xEAncio! Shhh!"
      - Udah malam! Diam! Sst!
      - Gabi na! Tahimik! Shhh!
      - "\u3082\u3046\u6DF1\u591C\uFF01\u9759\u304B\u306B\uFF01\u30B7\u30FC\u30C3\uFF01"
      - "\u591C\u6DF1\u4E86\uFF01\u5B89\u975C\uFF01\u5653~"
      - "\uC57C! \uBC24\uB2A6\uC5C8\uB2E4! \uC870\uC6A9\uD788! \uC27F!"
      - "\u0423\u0436\u0435 \u043F\u043E\u0437\u0434\u043D\u043E \u043D\u043E\u0447\u044C\u044E!
        \u041D\u0435 \u0448\u0443\u043C\u0438!"
      - "\xA1Es tarde por la noche! \xA1Baja la voz!"
      - "\xA1Es tarde en la noche! \xA1Baja la voz!"
      - "Gece ge\xE7 oldu!\nSesini k\u0131s!"
