    - Term: S_LevelTips_Des_level_105_5
      TermType: 0
      Description: 
      Languages:
      - "\u7F51\u7EDC\u4E2D\u65AD\uFF0C\u8BF7\u68C0\u67E5\u4F60\u7684\u7F51\u7EDC\u8FDE\u63A5"
