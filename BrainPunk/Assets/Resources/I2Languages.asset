    - Term: S_congraktTips_Des_level_42
      TermType: 0
      Description: 
      Languages:
      - "\u561B\u54E9\u561B\u54E9\u54C4\uFF01\u5B9A\uFF01"
      - Abracadabra ! stop !
      - Abracadabra! Parado!
      - Abrakadabra! Berhenti! Wow!
      - Abrakadabra! Stop! Wow!
      - "\u30A2\u30D6\u30E9\u30AB\u30C0\u30D6\u30E9\uFF01\u30B9\u30C8\u30C3\u30D7\uFF01"
      - "\u963F\u5E03\u62C9\u5361\u9054\u5E03\u62C9\uFF01\u505C\uFF01\u592A\u795E\uFF01"
      - "\uC544\uBE0C\uB77C\uCE74\uB2E4\uBE0C\uB77C! \uBA48\uCDB0! \uC640!"
      - "\u0410\u0431\u0440\u0430\u043A\u0430\u0434\u0430\u0431\u0440\u0430! \u0417\u0430\u043C\u0440\u0438!"
      - "\xA1Abracadabra! \xA1Quieto!"
      - "\xA1Abracadabra! \xA1Alto!"
      - Abrakadabra! Dur!
