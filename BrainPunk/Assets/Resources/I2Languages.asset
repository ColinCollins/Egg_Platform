        \u043A\u043D\u043E\u043F\u043A\u0443 \u0441\u043B\u0435\u0432\u0430 \u0441\u0432\u0435\u0440\u0445\u0443
        \u0438\u043B\u0438 \"\u041F\u0440\u044B\u0436\u043E\u043A\", \u0447\u0442\u043E\u0431\u044B
        \u0441\u043E\u0437\u0434\u0430\u0442\u044C \u0441\u0442\u0443\u043F\u0435\u043D\u044C\u043A\u0438."
      - "Arrastra cualquier bot\xF3n de la esquina superior izquierda o el bot\xF3n
