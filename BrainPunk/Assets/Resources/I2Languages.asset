      - "\u6211\u5C31\u662F\u8DF3\u8E8D\u4E4B\u738B\uFF01"
      - "\uB0B4\uAC00 \uBC14\uB85C \uC810\uD504 \uD0B9\uC774\uC57C!"
      - "\u042F \u043A\u043E\u0440\u043E\u043B\u044C \u043F\u0440\u044B\u0436\u043A\u043E\u0432!"
      - "\xA1Soy el Rey del salto!"
      - "\xA1Soy el Rey del salto!"
      - "Z\u0131plama kral\u0131 benim!"
