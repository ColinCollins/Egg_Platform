    - Term: S_LevelTips_Des_level_141_1
      TermType: 0
      Description: 
      Languages:
      - "\u5DF2\u6536\u96C6 <link=\"Level141CollectedNumber\">{0}</link> \u4E2A <sprite
        index=0 tint=0>\n\u5DF2\u8D85\u8D8A <link=\"Level141PercentNumber\">{1}</link>%
        \u7684\u73A9\u5BB6"
      - 'Collected <link="Level141CollectedNumber">{0}</link> <sprite index=0 tint=0>

        Ahead
        of <link="Level141PercentNumber">{1}</link>% of players'
      - 'Coletados <link="Level141CollectedNumber">{0}</link> <sprite index=0 tint=0>

        Superou
        <link="Level141PercentNumber">{1}</link>% dos jogadores'
      - 'Terkumpul <link="Level141CollectedNumber">{0}</link> <sprite index=0 tint=0>

        Mengungguli
        <link="Level141PercentNumber">{1}</link>% pemain'
      - 'Nakakuha ng <link="Level141CollectedNumber">{0}</link> <sprite index=0 tint=0>

        Nalampasan
        ang <link="Level141PercentNumber">{1}</link>% ng mga player'
      - "<link=\"Level141CollectedNumber\">{0}</link>\u500B\u306E<sprite index=0
        tint=0>\u3092\u7372\u5F97\n\u30D7\u30EC\u30A4\u30E4\u30FC\u306E<link=\"Level141PercentNumber\">{1}</link>%\u3092\u4E0A\u56DE\u3063\u305F"
      - "\u5DF2\u6536\u96C6 <link=\"Level141CollectedNumber\">{0}</link> \u500B <sprite
        index=0 tint=0>\n\u5DF2\u8D85\u8D8A <link=\"Level141PercentNumber\">{1}</link>%
        \u7684\u73A9\u5BB6"
      - "<link=\"Level141CollectedNumber\">{0}</link>\uAC1C <sprite index=0 tint=0>
        \uC218\uC9D1\n\uD50C\uB808\uC774\uC5B4 \uC911 <link=\"Level141PercentNumber\">{1}</link>%\uB97C
        \uC55E\uC9C8\uB800\uC5B4"
      - "\u0421\u043E\u0431\u0440\u0430\u043D\u043E <link=\"Level141CollectedNumber\">{0}</link>
        <sprite index=0 tint=0>\n\u041E\u043F\u0435\u0440\u0435\u0436\u0430\u0435\u0448\u044C
        <link=\"Level141PercentNumber\">{1}</link>% \u0438\u0433\u0440\u043E\u043A\u043E\u0432"
      - 'Has recogido <link="Level141CollectedNumber">{0}</link> <sprite index=0
        tint=0>

        Has superado al <link="Level141PercentNumber">{1}</link>%
        de los jugadores'
