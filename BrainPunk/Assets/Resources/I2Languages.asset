      - "\uBB38\uC774 \uB610 \uB610 \uB610 \uB610 \uB0A0\uC544\uAC14\uC5B4!"
      - "\u0414\u0432\u0435\u0440\u044C \u0441\u043D\u043E\u0432\u0430, \u0441\u043D\u043E\u0432\u0430,
        \u0441\u043D\u043E\u0432\u0430, \u0441\u043D\u043E\u0432\u0430 \u0432\u0437\u043B\u0435\u0442\u0435\u043B\u0430!"
      - "\xA1La puerta volvi\xF3 a volar, otra vez, otra vez, otra vez!"
      - "\xA1La puerta volvi\xF3 a volar! \xA1Otra vez, otra vez, otra vez!"
      - "Kap\u0131 yine yine yine yine u\xE7tu!"
