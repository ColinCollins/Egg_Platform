      - "\u5982\u679C\u9084\u80FD\u518D\u5FEB\u4E00\u9EDE\u7684\u8A71\uFF01"
      - "\uB354 \uBE68\uB77C\uC9C8 \uC218 \uC788\uB2E4\uBA74!"
      - "\u0415\u0441\u043B\u0438 \u0431\u044B \u0435\u0449\u0451 \u0431\u044B\u0441\u0442\u0440\u0435\u0435!"
      - "\xA1Si pudiera ser a\xFAn m\xE1s r\xE1pido!"
      - "\xA1Si pudiera ser a\xFAn m\xE1s r\xE1pido!"
      - "Ke\u015Fke daha da h\u0131zl\u0131 olabilseydi!"
