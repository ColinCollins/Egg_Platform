      - "\uD558\uB298\uB85C \uB05D\uC5C6\uC774 \uC810\uD504~ \uBD80\uC790\uB97C \uB5A8\uC5B4\uB728\uB9AC\uC790!
        \uD48D!"
      - "\u041F\u0440\u044B\u0433\u0430\u0439 \u0432\u0432\u0435\u0440\u0445 \u0431\u0435\u0437
        \u043E\u0441\u0442\u0430\u043D\u043E\u0432\u043A\u0438, \u0447\u0442\u043E\u0431\u044B
        \u0441\u0431\u0438\u0442\u044C \u0431\u043E\u0433\u0430\u0447\u0430."
