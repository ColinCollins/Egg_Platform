    - Term: S_congraktTips_Des_level_93
      TermType: 0
      Description: 
      Languages:
      - "\u54DF\u543C~\u98DE\u8D77\u6765\u4E86\uFF01"
      - Woohoo~ I'm flying!
      - Uhuu~ Estou voando!
      - Wuhuu~ Aku terbang!
      - Woohoo~ Lumilipad ako!
      - "\u30E4\u30C3\u30DB\u30FC~\u98DB\u3093\u3060\uFF01"
      - "\u55B2\u543C~\u98DB\u8D77\u4F86\u4E86\uFF01"
      - "\uC57C\uD638~ \uB0A0\uC544\uAC04\uB2E4!"
      - "\u0423\u0445\u0443\u0443~ \u042F \u043B\u0435\u0447\u0443!"
      - "\xA1Yuju~ Estoy volando!"
      - "\xA1Yuju~ Estoy volando!"
      - "Vuhuu~ U\xE7uyorum!"
