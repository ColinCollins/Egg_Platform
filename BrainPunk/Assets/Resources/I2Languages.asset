      TermType: 0
      Description: 
      Languages:
      - "\u4F60\u597D\uFF01\u6211\u8981\u8FDB\u6765\u4E86\u54E6\uFF01"
      - Hello! I'm Coming In!
      - "Ol\xE1! Estou entrando!"
      - Halo! Aku masuk, ya!
      - Hello! Papasok na ako!
      - "\u3053\u3093\u306B\u3061\u306F\uFF01\u5165\u308B\u3088\uFF01"
      - "\u4F60\u597D\uFF01\u6211\u8981\u9032\u4F86\u56C9\uFF01"
      - "\uC548\uB155! \uB4E4\uC5B4\uAC08\uAC8C!"
      - "\u041F\u0440\u0438\u0432\u0435\u0442! \u042F \u0437\u0430\u0445\u043E\u0436\u0443!"
      - "\xA1Hola! \xA1Voy a entrar!"
      - "\xA1Hola! \xA1Ya entro!"
      - "Merhaba! \u0130\xE7eri giriyorum!"
