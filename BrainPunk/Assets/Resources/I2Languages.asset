      - "\u706B\u7BAD\u51FA\u64CA\uFF01"
      - "\uB85C\uCF13 \uBC1C\uC0AC!"
      - "\u0420\u0430\u043A\u0435\u0442\u0430, \u0432\u043F\u0435\u0440\u0451\u0434!"
      - "\xA1Cohete, adelante!"
      - "\xA1Cohete, adelante!"
      - "Roket f\u0131rlat!"
