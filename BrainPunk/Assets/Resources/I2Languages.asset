      - "\u6211\u53EF\u4EE5\u5168\u90E8\u90FD\u9078\u64C7\uFF01"
      - "\uB098\uB294 \uC804\uBD80 \uC120\uD0DD\uD560 \uC218 \uC788\uC5B4!"
      - "\u042F \u043C\u043E\u0433\u0443 \u0432\u044B\u0431\u0440\u0430\u0442\u044C
        \u0432\u0441\u0451!"
