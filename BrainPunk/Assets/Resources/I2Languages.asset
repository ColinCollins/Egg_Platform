      - "\uB108\uBB34 \uBE44\uC881\uC544! \uB354\uB294 \uD0C0\uC9C0 \uB9C8!"
      - "\u0422\u0435\u0441\u043D\u043E! \u0411\u043E\u043B\u044C\u0448\u0435 \u043D\u0435
        \u0437\u0430\u0445\u043E\u0434\u0438\u0442\u0435!"
