      - "\u3053\u3053\u306B\u306F\u7121\u9650\u306E\u98A8\u8239\u304C\u3042\u308B\uFF01"
      - "\u9019\u88E1\u6709\u7121\u9650\u7684\u6C23\u7403\uFF01"
      - "\uC5EC\uAE30\uC5D4 \uBB34\uD55C\uD55C \uD48D\uC120\uC774 \uC788\uC5B4!"
      - "\u0417\u0434\u0435\u0441\u044C \u0431\u0435\u0441\u043A\u043E\u043D\u0435\u0447\u043D\u043E\u0435
        \u043A\u043E\u043B\u0438\u0447\u0435\u0441\u0442\u0432\u043E \u0448\u0430\u0440\u0438\u043A\u043E\u0432!"
