    - Term: S_LevelTips_Des_level_140_5
      TermType: 0
      Description: 
      Languages:
      - "\u5FEB\u70B9\u5427\uFF0C\u7B49\u5F97\u82B1\u90FD\u8981\u8C22\u4E86\uFF01"
