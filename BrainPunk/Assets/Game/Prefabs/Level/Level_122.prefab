  deadlockTipJa: "\u6D88\u305B\u308B\u7D44\u307F\u5408\u308F\u305B\u304C\u3042\u308A\u307E\u305B\u3093\u3002\u3084\u308A\u76F4\u3057\u307E\u3059\u3002"
  deadlockTipZhTw: "\u6C92\u6709\u53EF\u6D88\u9664\u7684\u7D44\u5408\uFF0C\u6B63\u5728\u91CD\u65B0\u958B\u59CB"
